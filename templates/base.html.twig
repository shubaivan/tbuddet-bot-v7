<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Welcome!{% endblock %}</title>
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        <link rel="shortcut icon" type="image/x-icon" href="{{ asset('admin.jpg') }}">
    {% endblock %}
</head>
{# Разом із CRM це одна адмінка: той самий фон, ширина, кнопки й поля (клас adm). #}
<body class="{{ crm_url is defined and crm_url and is_granted('ROLE_MANAGER') ? 'adm' }}">
{% block body %}
    {#
        Одна адмінка на все: верхній ряд розділів той самий, що в CRM заявок і на складі
        (zayavky.artbeton.market). Магазин — лише один із розділів; вхід і вихід — через CRM.
        Без crm_url (локальна розробка) — стара шапка.
    #}
    {% if crm_url and is_granted('ROLE_MANAGER') %}
        {% set route = app.request.attributes.get('_route') %}
        {% set crm = crm_url|trim('/', 'right') %}
        <style>
            .adm-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; max-width: 1240px; margin: 0 auto; padding: 14px 16px 12px; border-bottom: 1px solid #e3e6ea; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
            .adm-sections, .adm-sub { display: flex; flex-wrap: wrap; gap: 4px; }
            .adm-sections a { padding: 7px 14px; border-radius: 999px; color: #6a7280; font-weight: 600; white-space: nowrap; text-decoration: none; }
            .adm-sections a:hover { color: #1b1f24; background: #e8f0fc; text-decoration: none; }
            .adm-sections a.on { background: #2f6fd0; color: #fff; }
            .adm-sub { max-width: 1240px; margin: 0 auto 12px; padding: 10px 16px 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
            .adm-sub a { padding: 6px 12px; border-radius: 8px; color: #6a7280; white-space: nowrap; text-decoration: none; }
            .adm-sub a.on { background: #e8f0fc; color: #2f6fd0; }
            .adm-who { color: #6a7280; font-size: 13px; }
            @media (max-width: 640px) {
                .adm-sections, .adm-sub { flex-wrap: nowrap; overflow-x: auto; width: 100%; -webkit-overflow-scrolling: touch; }
                .adm-sections a, .adm-sub a { padding: 10px 14px; }
            }

            /* Сторінки магазину — у тих самих кольорах і сітці, що CRM і склад. */
            body.adm { background: #f6f7f9; color: #1b1f24; font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
            body.adm > *:not(.adm-top):not(.adm-sub):not(script):not(style):not(.modal):not(.modal-backdrop) {
                max-width: 1240px; margin-left: auto; margin-right: auto; padding-left: 16px; padding-right: 16px;
            }
            body.adm .adm-top, body.adm .adm-sub { background: transparent; }
            /* Кнопка-посилання прямо в body (як «+ Створити Продукт») — на ту ж лінію, що й контент. */
            body.adm > a.btn { display: inline-block; margin: 0 0 12px max(16px, calc((100vw - 1240px) / 2 + 16px)); }
            body.adm .btn { border-radius: 8px; }
            body.adm .btn-primary { background: #2f6fd0; border-color: #2f6fd0; }
            body.adm .btn-primary:hover { background: #255bb0; border-color: #255bb0; }
            body.adm .form-control, body.adm select, body.adm input { border-radius: 8px; }
            body.adm table.dataTable, body.adm .table { background: #fff; border-radius: 8px; }
            body.adm .dataTables_wrapper { background: #fff; border: 1px solid #e3e6ea; border-radius: 12px; padding: 12px 14px; margin-bottom: 16px; }
            body.adm .alert { max-width: 1240px; margin-left: auto; margin-right: auto; }
            body.adm h1, body.adm h2 { font-weight: 700; }
            @media (max-width: 640px) {
                body.adm .dataTables_wrapper { padding: 8px; overflow-x: auto; }
                body.adm input, body.adm select, body.adm textarea { font-size: 16px; }
            }
        </style>
        <header class="adm-top">
            <nav class="adm-sections">
                <a href="{{ crm }}/crm/">📦 Заявки</a>
                <a href="{{ crm }}/crm/schedule">🚗 Автопарк</a>
                <a href="{{ crm }}/sklad">🏗 Склад</a>
                <a class="on" href="{{ path('app_admin_orders') }}">🛒 Магазин</a>
            </nav>
            <span class="adm-who">{{ app.user.firstName ?? app.user.userIdentifier }} · <a href="{{ path('login_app_logout') }}">вийти</a></span>
        </header>
        <nav class="adm-sub">
            <a href="{{ path('app_admin_orders') }}" class="{{ route starts with 'app_admin_order' ? 'on' }}">Замовлення</a>
            <a href="{{ path('app_admin_products') }}" class="{{ route starts with 'app_admin_product' or route starts with 'admin-product' ? 'on' }}">Товари</a>
            <a href="{{ path('app_admin_categories') }}" class="{{ route starts with 'app_admin_categor' or route starts with 'admin-category' ? 'on' }}">Категорії</a>
            <a href="{{ path('app_admin_users') }}" class="{{ route starts with 'app_admin_user' ? 'on' }}">Покупці</a>
            <a href="{{ path('app_admin_promocodes') }}" class="{{ route starts with 'app_admin_promocode' ? 'on' }}">Промокоди</a>
        </nav>
    {% else %}
    <header>
        <div class="collapse bg-dark" id="navbarHeader">
            <div class="container">
                <div class="row">
                    <div class="col-sm-8 col-md-7 py-4">
                        <h4 class="text-white">You are</h4>
                        <p class="text-muted">
                            Hello, {{ app.user.userIdentifier }}
                        </p>
                    </div>
                    <div class="col-sm-4 offset-md-1 py-4">
                        {#<h4 class="text-white">Navigation</h4>#}
                        <ul class="list-unstyled">
                            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                                <li>
                                    <a href="{{ path('login_app_logout') }}" class="text-white row align-items-center">
                                        Logout <i class="fas fa-sign-out-alt fa-3x"></i>
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="navbar navbar-dark bg-dark shadow-sm">
            <div class="container d-flex justify-content-between">
                {% if is_granted('IS_AUTHENTICATED_REMEMBERED')%}
                    <a href="{{ path('app_admin') }}" class="navbar-brand d-flex align-items-center">
                        <i class="fas fa-home"></i>
                    </a>
                {% endif %}

                {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                    You are logged.
                {% else %}
                    <a href="{{ path('app_login') }}" class="float-lg-left">
                        Login <i class="fas fa-door-open"></i>
                    </a>
                {% endif %}

                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarHeader"
                        aria-controls="navbarHeader" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </div>
    </header>
    {% endif %}

    {# read and display all flash messages #}
    {#    {{ dump(app.flashes) }}#}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            {% if label == 'warning' %}
                {% set class = 'alert-warning' %}
            {% elseif label == 'notice' %}
                {% set class = 'alert-success' %}
            {% elseif label == 'error' %}
                {% set class = 'alert-danger' %}
            {% else %}
                {% set class = 'alert-success' %}
            {% endif %}

            <div class="alert {{ class }}" role="alert">
                <h4 class="alert-heading">{{label|capitalize}}</h4>
                <p class="mb-0"><i class="fa fa-exclamation-circle"></i>{{message}}</p>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="alert alert-danger" role="alert" style="display: none">
        <h4 class="alert-heading">Error</h4>
        <p class="mb-0"><i class="fa fa-exclamation-circle"></i>Warning</p>
    </div>

    <div class="alert alert-success" role="alert" style="display: none">
        <h4 class="alert-heading">Successful!</h4>
        <p class="mb-0"><i class="fab fa-angellist"></i>Successful</p>
    </div>
{% endblock %}
{% block javascripts %}
    {{ encore_entry_script_tags('app') }}

{#    <script src="{{ asset('bundles/fosjsrouting/js/router.min.js') }}"></script>#}
{#    <script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>#}
    <script src="/bundles/fosjsrouting/js/router.min.js"></script>
    <script src="/js/fos_js_routes.js"></script>

{% endblock %}
</body>
</html>
