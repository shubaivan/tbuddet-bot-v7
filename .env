###> symfony/google-mailer ###
# Gmail SHOULD NOT be used on production, use it in development only.
# MAILER_DSN=gmail://USERNAME:PASSWORD@default
###< symfony/google-mailer ###

###> support-chat AI assistant ###
# Real key goes in .env.local (gitignored) — NEVER commit a real key here.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5
# Global daily spend ceiling (UAH). Over this, the consultant degrades to the
# "leave your number, operator will call" path. 0 disables the ceiling.
AI_DAILY_BUDGET_UAH=200
# USD→UAH rate used to convert Claude token cost into UAH for the budget guard.
USD_UAH_RATE=42
###< support-chat AI assistant ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> єдиний вхід через CRM ###
# CRM (zayavky) — єдина точка входу; адмінка магазину пускає за її підписаним пропуском.
# Порожній CRM_URL — стара сторінка входу віджетом (локальна розробка).
CRM_URL=
CRM_SSO_SECRET=
###< єдиний вхід через CRM ###
